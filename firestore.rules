rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hjælpefunktion: rigtig konto (ikke anonym gæst). Gæster (anonym auth)
    // må LÆSE aktiviteter/profiler for at browse kortet, men aldrig skrive —
    // uden dette skel ville anonym login give gæster fuld skriveadgang.
    function isFullUser() {
      return request.auth != null &&
             request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Hjælpefunktion: er brugeren admin?
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    // Hjælpefunktion: er brugeren admin eller moderator?
    function isStaff() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null &&
             (userData.admin == true || userData.moderator == true);
    }

    // Aldersvalidering: brugeren skal være mindst 18 år
    // Beregner ca. fødselstidspunkt + 18 år i millisekunder og sammenligner med request.time
    function isOldEnough(birthday) {
      return birthday is map &&
             birthday.year is int && birthday.month is int && birthday.day is int &&
             birthday.year >= 1900 &&
             birthday.month >= 1 && birthday.month <= 12 &&
             birthday.day >= 1 && birthday.day <= 31 &&
             request.time.toMillis() > ((birthday.year + 18 - 1970) * 31557600000 + (birthday.month - 1) * 2629800000 + (birthday.day - 1) * 86400000);
    }

    // Feltvalidering
    function validDisplayName(name) {
      return name is string && name.size() <= 50;
    }
    function validBio(bio) {
      return bio is string && bio.size() <= 500;
    }
    function validUserData(data) {
      return validDisplayName(data.displayName) &&
             (!('bio' in data) || validBio(data.bio));
    }

    // Brugerprofiler
    match /users/{userId} {
      // Alle indloggede brugere kan læse profiler (til HomeScreen-grid og profilvisning)
      allow read: if request.auth != null;

      // Oprettelse kræver gyldig fødselsdato med alder >= 13
      allow create: if isFullUser() && request.auth.uid == userId &&
                       'birthday' in request.resource.data &&
                       isOldEnough(request.resource.data.birthday) &&
                       validUserData(request.resource.data);

      // Brugeren selv kan opdatere sin profil, men ikke ændre fødselsdato
      allow update: if isFullUser() && request.auth.uid == userId &&
                       (!('birthday' in resource.data) || request.resource.data.birthday == resource.data.birthday) &&
                       validUserData(request.resource.data);

      // Admins og moderatorer kan opdatere enhver bruger (ban, suspend, warn)
      allow update: if isStaff();

      // Ingen sletter profiler via klienten
      allow delete: if false;
    }

    // Bruger-lokationer (separat for hyppige opdateringer)
    match /userLocations/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isFullUser() && request.auth.uid == userId;
      allow create, update: if isAdmin();
      allow delete: if isFullUser() && request.auth.uid == userId;
    }

    // Rapporter
    match /reports/{reportId} {
      // Kun den indloggede bruger kan oprette en rapport, og reporterId skal matche
      allow create: if isFullUser() &&
                       request.resource.data.reporterId == request.auth.uid &&
                       (!('reason' in request.resource.data) || (request.resource.data.reason is string && request.resource.data.reason.size() <= 5000));

      // Admins og moderatorer kan læse og opdatere rapporter
      allow read, update: if isStaff();

      allow delete: if false;
    }

    // Blokeringer
    match /blocks/{blockId} {
      allow create: if isFullUser() &&
                       request.resource.data.blockerId == request.auth.uid;
      allow read, update: if isStaff();
      allow delete: if false;
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow create: if isFullUser() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() <= 5000;
      // Brugeren kan tilføje imageURL til sin egen feedback
      allow update: if isFullUser() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imageURL']);
      allow read, update: if isStaff();
      allow delete: if isAdmin();
    }

    // App-konfiguration (showTestBadges mv.)
    // App-config er offentlig læsbar (UI-toggles, ikke følsom data)
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Flagged content (fotomoderering)
    match /flaggedContent/{docId} {
      allow read, update: if isStaff();
      allow create, delete: if false;
    }

    // Collection group query: staff kan læse alle beskeder (Billeder/moderation)
    match /{path=**}/messages/{messageId} {
      allow read: if isStaff();
    }

    // "Hold kontakten"-anmodninger (Pivot 2.0). Doc-id = sorteret uid-par —
    // samme id som parrets connection-chat, så chat-reglerne kan slå
    // anmodningen op via deres eget chatId.
    match /contactRequests/{pairId} {
      // Kun de to parter kan læse. To betingelser fordi:
      // - pairId.split('_'): dækker get() på IKKE-eksisterende docs
      //   (resource er null før første anmodning — klienten skal kunne
      //   spørge "findes der en anmodning?" og få nej)
      // - resource.data-tjekket: gør list-queries (where from/to == mig)
      //   bevislige for regel-motoren
      allow read: if isFullUser() &&
                     (request.auth.uid in pairId.split('_') ||
                      request.auth.uid == resource.data.from ||
                      request.auth.uid == resource.data.to);

      // AKTIVITETS-GATEN: anmodning kræver at BEGGE er deltagere i det
      // angivne event lige nu (verificeret server-side — klienten kan ikke
      // opdigte fælles deltagelse). Muligt så længe event-doc'et lever,
      // dvs. under eventet + grace-perioden.
      allow create: if isFullUser() &&
                       request.resource.data.from == request.auth.uid &&
                       request.resource.data.to is string &&
                       request.resource.data.to != request.auth.uid &&
                       (pairId == request.resource.data.from + '_' + request.resource.data.to ||
                        pairId == request.resource.data.to + '_' + request.resource.data.from) &&
                       request.resource.data.status == 'pending' &&
                       get(/databases/$(database)/documents/events/$(request.resource.data.eventId))
                         .data.participantIds.hasAll([request.resource.data.from, request.resource.data.to]);

      // Accept: KUN modtageren, KUN status-feltet, KUN pending → accepted
      allow update: if isFullUser() &&
                       request.auth.uid == resource.data.to &&
                       resource.data.status == 'pending' &&
                       request.resource.data.status == 'accepted' &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // Afsender kan fortryde sin egen afventende anmodning
      allow delete: if isFullUser() &&
                       request.auth.uid == resource.data.from &&
                       resource.data.status == 'pending';
    }

    // Chat-dokumenter
    match /chats/{chatId} {
      // Kun deltagere kan læse chat-dokumentet
      allow read: if request.auth != null &&
                     request.auth.uid in resource.data.participants;

      // Admins og moderatorer kan læse alle chats (til moderation)
      allow read: if isStaff();

      // PIVOT 2.0 — DET STRUKTURELLE ANTI-DATING-GREB: kold 1:1-chat kan
      // ikke længere oprettes. Kun to slags chats kan opstå:

      // 1) Event-gruppechat (oprettes sammen med eventet)
      allow create: if isFullUser() &&
                       request.auth.uid in request.resource.data.participants &&
                       'eventId' in request.resource.data;

      // 2) Connection-chat: kræver en ACCEPTERET kontakt-anmodning mellem
      //    parret. Connection-chatId == contactRequests-pairId, så opslaget
      //    er direkte på chatId.
      allow create: if isFullUser() &&
                       request.auth.uid in request.resource.data.participants &&
                       request.resource.data.participants.size() == 2 &&
                       request.resource.data.type == 'connection' &&
                       exists(/databases/$(database)/documents/contactRequests/$(chatId)) &&
                       get(/databases/$(database)/documents/contactRequests/$(chatId)).data.status == 'accepted';

      // 3) LEGACY — SLETTES I FASE 7 når v2.0.0 har erstattet v1.1.9:
      //    den live Play-app (grid) opretter kolde 1:1-chats fra profiler.
      //    Reglen holder den i live, uden at røre de to nye veje ovenfor.
      allow create: if isFullUser() &&
                       request.auth.uid in request.resource.data.participants &&
                       !('type' in request.resource.data) &&
                       !('eventId' in request.resource.data);

      // Staff kan oprette chats (admin-panel events)
      allow create: if isStaff();

      // Staff kan opdatere chat-felter (admin-panel events: eventTitle, eventTag, expiresAt)
      allow update: if isStaff();

      // Kun deltagere kan opdatere (lastMessage, lastMessageTime)
      allow update: if isFullUser() &&
                       request.auth.uid in resource.data.participants &&
                       (!('lastMessage' in request.resource.data) || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 500));

      // Event-chat: tillad join/leave (tilføj/fjern sig selv fra participants)
      allow update: if isFullUser() &&
                       'eventId' in resource.data &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']) &&
                       (
                         (!(request.auth.uid in resource.data.participants) &&
                          request.auth.uid in request.resource.data.participants) ||
                         (request.auth.uid in resource.data.participants &&
                          !(request.auth.uid in request.resource.data.participants))
                       );

      // Deltager kan markere samtalen som ryddet for sig selv (slet-for-mig).
      // Kun feltet clearedBy må røres; chat-doc'et slettes aldrig så modparten beholder den.
      allow update: if isFullUser() &&
                       request.auth.uid in resource.data.participants &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clearedBy']);

      // Staff kan slette chats (til moderation/cleanup af events)
      allow delete: if isStaff();

      // Beskeder i chatten
      match /messages/{messageId} {
        // Kun deltagere kan læse beskeder
        allow read: if request.auth != null &&
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // Admins og moderatorer kan læse alle beskeder (til moderation)
        allow read: if isStaff();

        // Kun deltagere kan sende beskeder, og senderId skal matche den indloggede bruger
        allow create: if isFullUser() &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                         request.resource.data.senderId == request.auth.uid &&
                         (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 2000));

        // Deltagere kan opdatere beskeder (likedBy, deleted)
        // revealedBy kan kun sættes af modtageren (ikke afsenderen)
        allow update: if isFullUser() &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['revealedBy']) ||
                          request.auth.uid != resource.data.senderId);

        // Admins kan opdatere beskeder (moderation: slet beskeder)
        allow update: if isAdmin();

        // Staff kan slette beskeder (til cleanup af events)
        allow delete: if isStaff();

        // Deltager kan slette sine EGNE beskeder (slet-for-mig / tilbagetræk).
        // Kun afsenderen, og kun hvis stadig deltager i chatten.
        allow delete: if isFullUser() &&
                         resource.data.senderId == request.auth.uid &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // Events (åbne invitationer / gruppeopslag)
    match /events/{eventId} {
      // Alle indloggede brugere kan læse events (til at se i nærheden)
      allow read: if request.auth != null;

      // Kun brugere med rigtig konto kan oprette events, og creatorId skal matche
      allow create: if isFullUser() &&
                       request.resource.data.creatorId == request.auth.uid &&
                       request.auth.uid in request.resource.data.participantIds &&
                       request.resource.data.title is string &&
                       request.resource.data.title.size() > 0 &&
                       request.resource.data.title.size() <= 100 &&
                       (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 500)) &&
                       (!('meetingPlace' in request.resource.data) || (request.resource.data.meetingPlace is string && request.resource.data.meetingPlace.size() <= 100));

      // Staff kan oprette events på vegne af enhver bruger (admin-panel)
      allow create: if isStaff();

      // Creator kan opdatere alle felter, andre kan kun ændre participantIds (join/leave)
      allow update: if isFullUser() &&
                       request.auth.uid == resource.data.creatorId;

      // Staff kan opdatere alle felter (admin-panel redigering)
      allow update: if isStaff();
      allow update: if isFullUser() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds']) &&
                       (
                         // Join: tilføj sig selv
                         (!(request.auth.uid in resource.data.participantIds) &&
                          request.auth.uid in request.resource.data.participantIds &&
                          (resource.data.maxParticipants == null || request.resource.data.participantIds.size() <= resource.data.maxParticipants)) ||
                         // Leave: fjern sig selv
                         (request.auth.uid in resource.data.participantIds &&
                          !(request.auth.uid in request.resource.data.participantIds))
                       );

      // Creator + staff kan slette
      allow delete: if isFullUser() &&
                       (request.auth.uid == resource.data.creatorId || isStaff());
    }
  }
}
