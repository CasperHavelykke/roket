rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hjælpefunktion: er brugeren admin?
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    // Hjælpefunktion: er brugeren admin eller moderator?
    function isStaff() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null &&
             (userData.admin == true || userData.moderator == true);
    }

    // Aldersvalidering: brugeren skal være mindst 18 år
    // Beregner ca. fødselstidspunkt + 18 år i millisekunder og sammenligner med request.time
    function isOldEnough(birthday) {
      return birthday is map &&
             birthday.year is int && birthday.month is int && birthday.day is int &&
             birthday.year >= 1900 &&
             birthday.month >= 1 && birthday.month <= 12 &&
             birthday.day >= 1 && birthday.day <= 31 &&
             request.time.toMillis() > ((birthday.year + 18 - 1970) * 31557600000 + (birthday.month - 1) * 2629800000 + (birthday.day - 1) * 86400000);
    }

    // Feltvalidering
    function validDisplayName(name) {
      return name is string && name.size() <= 50;
    }
    function validBio(bio) {
      return bio is string && bio.size() <= 500;
    }
    function validUserData(data) {
      return validDisplayName(data.displayName) &&
             (!('bio' in data) || validBio(data.bio));
    }

    // Brugerprofiler
    match /users/{userId} {
      // Alle indloggede brugere kan læse profiler (til HomeScreen-grid og profilvisning)
      allow read: if request.auth != null;

      // Oprettelse kræver gyldig fødselsdato med alder >= 13
      allow create: if request.auth != null && request.auth.uid == userId &&
                       'birthday' in request.resource.data &&
                       isOldEnough(request.resource.data.birthday) &&
                       validUserData(request.resource.data);

      // Brugeren selv kan opdatere sin profil, men ikke ændre fødselsdato
      allow update: if request.auth != null && request.auth.uid == userId &&
                       (!('birthday' in resource.data) || request.resource.data.birthday == resource.data.birthday) &&
                       validUserData(request.resource.data);

      // Admins og moderatorer kan opdatere enhver bruger (ban, suspend, warn)
      allow update: if isStaff();

      // Ingen sletter profiler via klienten
      allow delete: if false;
    }

    // Bruger-lokationer (separat for hyppige opdateringer)
    match /userLocations/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow create, update: if isAdmin();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Rapporter
    match /reports/{reportId} {
      // Kun den indloggede bruger kan oprette en rapport, og reporterId skal matche
      allow create: if request.auth != null &&
                       request.resource.data.reporterId == request.auth.uid &&
                       (!('reason' in request.resource.data) || (request.resource.data.reason is string && request.resource.data.reason.size() <= 5000));

      // Admins og moderatorer kan læse og opdatere rapporter
      allow read, update: if isStaff();

      allow delete: if false;
    }

    // Blokeringer
    match /blocks/{blockId} {
      allow create: if request.auth != null &&
                       request.resource.data.blockerId == request.auth.uid;
      allow read, update: if isStaff();
      allow delete: if false;
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() <= 5000;
      // Brugeren kan tilføje imageURL til sin egen feedback
      allow update: if request.auth != null &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imageURL']);
      allow read, update: if isStaff();
      allow delete: if isAdmin();
    }

    // App-konfiguration (showTestBadges mv.)
    // App-config er offentlig læsbar (UI-toggles, ikke følsom data)
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Flagged content (fotomoderering)
    match /flaggedContent/{docId} {
      allow read, update: if isStaff();
      allow create, delete: if false;
    }

    // Collection group query: staff kan læse alle beskeder (Billeder/moderation)
    match /{path=**}/messages/{messageId} {
      allow read: if isStaff();
    }

    // Chat-dokumenter
    match /chats/{chatId} {
      // Kun deltagere kan læse chat-dokumentet
      allow read: if request.auth != null &&
                     request.auth.uid in resource.data.participants;

      // Admins og moderatorer kan læse alle chats (til moderation)
      allow read: if isStaff();

      // Enhver indlogget bruger kan oprette en ny chat
      // (chatId er deterministisk og indeholder begge UIDs)
      allow create: if request.auth != null &&
                       request.auth.uid in request.resource.data.participants;

      // Kun deltagere kan opdatere (lastMessage, lastMessageTime)
      allow update: if request.auth != null &&
                       request.auth.uid in resource.data.participants &&
                       (!('lastMessage' in request.resource.data) || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 500));

      allow delete: if false;

      // Beskeder i chatten
      match /messages/{messageId} {
        // Kun deltagere kan læse beskeder
        allow read: if request.auth != null &&
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // Admins og moderatorer kan læse alle beskeder (til moderation)
        allow read: if isStaff();

        // Kun deltagere kan sende beskeder, og senderId skal matche den indloggede bruger
        allow create: if request.auth != null &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                         request.resource.data.senderId == request.auth.uid &&
                         (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 2000));

        // Deltagere kan opdatere beskeder (likedBy, deleted)
        // revealedBy kan kun sættes af modtageren (ikke afsenderen)
        allow update: if request.auth != null &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['revealedBy']) ||
                          request.auth.uid != resource.data.senderId);

        // Admins kan opdatere beskeder (moderation: slet beskeder)
        allow update: if isAdmin();

        allow delete: if false;
      }
    }
  }
}
