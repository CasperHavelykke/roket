{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest", "node"],
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // web/ og admin/ har egne tsconfigs (Vite/DOM) — uden exclude drukner
  // mobil-typechecket i ~50 falske DOM-fejl og er ubrugeligt som gate
  "exclude": ["**/node_modules", "**/Pods", "web", "admin"]
}
