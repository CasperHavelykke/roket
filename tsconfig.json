{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest", "node"],
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // admin/ har egen tsconfig (Vite/DOM) — uden exclude drukner
