rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profilbilleder: profilePhotos/{userId}.jpg
    match /profilePhotos/{userId}.jpg {
      // Alle indloggede kan læse (til HomeScreen-grid og profilvisning)
      allow read: if request.auth != null;

      // Kun brugeren selv kan uploade/overskrive sit billede
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.contentType.matches('image/.*') &&
                      request.resource.size < 5 * 1024 * 1024; // Maks 5 MB
    }

    // Chat-billeder: chatImages/{chatId}/{messageId}.jpg
    match /chatImages/{chatId}/{messageId} {
      // Kun indloggede brugere kan læse og skrive chat-billeder
      // (fuld deltager-tjek er dyrt i Storage rules, så vi kræver bare auth)
      allow read: if request.auth != null;

      allow write: if request.auth != null &&
                      request.resource.contentType.matches('image/.*') &&
                      request.resource.size < 10 * 1024 * 1024; // Maks 10 MB
    }
  }
}
